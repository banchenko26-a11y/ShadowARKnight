{
  "name": "endfield-menu",
  "version": "1.3.0",
  "description": "ShadowARK — компаньон-оверлей для Arknights: Endfield: карта, тренер ротаций, таймеры и заметки поверх игры",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.shadowark.overlay",
    "productName": "ShadowARK",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ShadowARK-${version}.exe"
    }
  }
}